<?xml version="1.0" encoding="UTF-8"?>
<QtHelpProject version="1.0">
    <namespace>tidop.com.graphos.2.0</namespace>
    <virtualFolder>doc</virtualFolder>
    <customFilter name="GRAPHOS Spanish">
        <filterAttribute>graphos</filterAttribute>
        <filterAttribute>spanish</filterAttribute>
    </customFilter>
    <filterSection>
        <filterAttribute>graphos</filterAttribute>
        <filterAttribute>spanish</filterAttribute>
        <toc>
            <section title="GRAPHOS — Ayuda" ref="index.html">
                <section title="Flujo de trabajo" ref="workflow.html"/>
                <section title="Herramientas" ref="tools.html"/>
                <section title="Interfaz" ref="interface.html"/>
                <section title="Línea de comandos" ref="commands.html"/>
            </section>
        </toc>
        <keywords>
            <keyword name="Flujo de trabajo" id="workflow" ref="workflow.html"/>
            <keyword name="Herramientas" id="tools" ref="tools.html"/>
            <keyword name="Interfaz" id="interface" ref="interface.html"/>
            <keyword name="Línea de comandos" id="commands" ref="commands.html"/>
            <keyword name="Comandos" id="commands-list" ref="commands.html"/>
        </keywords>
        <files>
            <file>index.html</file>
            <file>workflow.html</file>
            <file>tools.html</file>
            <file>interface.html</file>
            <file>commands.html</file>
            <file>css/styles.css</file>
            <file>images/*.png</file>
        </files>
    </filterSection>
</QtHelpProject>
